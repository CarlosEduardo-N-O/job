                "responses": {
                    "200": {
                        "description": "Logout realizado com sucesso"
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/logon": {
            "get": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Retorna o usuário autenticado",
                "operationId": "34e30fbe9c4f03e816c26679da45dc9c",
                "responses": {
                    "200": {
                        "description": "Usuário autenticado"
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/negociacoes": {
            "get": {
                "tags": [
                    "Negociações"
                ],
                "summary": "Lista as negociações do usuário autenticado",
                "description": "Retorna as negociações em que o usuário participa como interessado ou contratante.",
                "operationId": "e5946a1778f9dff10056a3d6597e1e81",
                "responses": {
                    "200": {
                        "description": "Lista de negociações"
                    },
                    "401": {
                        "description": "Usuário não autenticado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/negociacoes/{negociacao}": {
            "get": {
                "tags": [
                    "Negociações"
                ],
                "summary": "Exibe uma negociação",
                "description": "Retorna a negociação e todo o histórico de interações entre os participantes.",
                "operationId": "80a3499ec119ef1b1c953031b39a7e94",
                "parameters": [
                    {
                        "name": "negociacao",
                        "in": "path",
                        "description": "ID da negociação",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Negociação encontrada"
                    },
                    "403": {
                        "description": "Usuário não participa desta negociação"
                    },
                    "404": {
                        "description": "Negociação não encontrada"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/publicacoes/{publicacao}/interacoes": {
            "post": {
                "tags": [
                    "Negociações"
                ],
                "summary": "Inicia uma negociação com uma publicação",
                "description": "Cria a primeira interação do usuário com uma publicação e cria automaticamente uma negociação. Não permite iniciar uma nova negociação quando já existe uma negociação FECHADA para a publicação.",
                "operationId": "b429f8cca8ceedebbf7a3d793de9a25d",
                "parameters": [
                    {
                        "name": "publicacao",
                        "in": "path",
                        "description": "ID da publicação",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "tipo"
                                ],
                                "properties": {
                                    "tipo": {
                                        "description": "Tipo da primeira interação",
                                        "type": "string",
                                        "example": "PROPOSTA",
                                        "enum": [
                                            "INTERESSE",
                                            "PROPOSTA",
                                            "DUVIDA"
                                        ]
                                    },
                                    "mensagem": {
                                        "description": "Mensagem da interação",
                                        "type": "string",
                                        "example": "Consigo realizar o serviço por este valor.",
                                        "nullable": true
                                    },
                                    "valor_proposto": {
                                        "description": "Valor da proposta. Obrigatório quando o tipo for PROPOSTA.",
                                        "type": "number",
                                        "format": "float",
                                        "example": 320,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Negociação criada com sucesso"
                    },
                    "401": {
                        "description": "Usuário não autenticado"
                    },
                    "403": {
                        "description": "Usuário não pode interagir com esta publicação"
                    },
                    "422": {
                        "description": "Dados inválidos, negociação já existente ou a publicação já possui uma negociação fechada"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/negociacoes/{negociacao}/interacoes": {
            "post": {
                "tags": [
                    "Negociações"
                ],
                "summary": "Recusa uma manifestação de interesse ou proposta",
                "description": "Interações do tipo INTERESSE ou PROPOSTA podem ser recusadas diretamente. DUVIDA deve ser respondida com uma nova interação.",
                "operationId": "c579e8e628506baa8e04fe987b9625aa",
                "parameters": [
                    {
                        "name": "negociacao",
                        "in": "path",
                        "description": "ID da negociação",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "tipo"
                                ],
                                "properties": {
                                    "tipo": {
                                        "description": "Tipo da nova interação. O tipo permitido depende da última interação da negociação.",
                                        "type": "string",
                                        "example": "PROPOSTA",
                                        "enum": [
                                            "INTERESSE",
                                            "PROPOSTA",
                                            "DUVIDA"
                                        ]
                                    },
                                    "mensagem": {
                                        "description": "Mensagem da interação",
                                        "type": "string",
                                        "example": "Consigo fazer por R$ 340.",
                                        "nullable": true
                                    },
                                    "valor_proposto": {
                                        "description": "Valor da nova proposta. Obrigatório quando o tipo for PROPOSTA.",
                                        "type": "number",
                                        "format": "float",
                                        "example": 340,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Interação enviada com sucesso"
                    },
                    "403": {
                        "description": "Usuário não participa da negociação"
                    },
                    "422": {
                        "description": "Não é a vez do usuário, o tipo de interação não é permitido para o estado atual da negociação ou os dados são inválidos"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/negociacoes/{negociacao}/aceitar": {
            "post": {
                "tags": [
                    "Negociações"
                ],
                "summary": "Aceita a última interação",
                "description": "Somente o contratante pode aceitar. INTERESSE e PROPOSTA podem ser aceitos quando a última interação foi enviada pelo interessado. DUVIDA não pode ser aceita diretamente e deve ser respondida. Ao fechar uma negociação, as demais negociações abertas da mesma publicação são encerradas.",
                "operationId": "4e7e488352cb180fee4e99c64063fc4c",
                "parameters": [
                    {
                        "name": "negociacao",
                        "in": "path",
                        "description": "ID da negociação",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Negociação fechada com sucesso"
                    },
                    "403": {
                        "description": "Usuário não participa da negociação ou não é o contratante"
                    },
                    "422": {
                        "description": "Negociação não pode ser aceita"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/negociacoes/{negociacao}/recusar": {
            "post": {
                "tags": [
                    "Negociações"
                ],
                "summary": "Recusa uma manifestação de interesse",
                "description": "Somente uma interação do tipo INTERESSE pode ser recusada diretamente. PROPOSTA deve ser aceita ou respondida com uma nova proposta. DUVIDA deve ser respondida com uma nova interação.",
                "operationId": "9917306ca9457f9c9d0e1b45733aa130",
                "parameters": [
                    {
                        "name": "negociacao",
                        "in": "path",
                        "description": "ID da negociação",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Negociação encerrada com sucesso"
                    },
                    "403": {
                        "description": "Usuário não participa da negociação"
                    },
                    "422": {
                        "description": "A interação não pode ser recusada"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/publicacoes": {
            "get": {
                "tags": [
                    "Publicações"
                ],
                "summary": "Lista publicações disponíveis para o usuário autenticado",
                "description": "Retorna somente publicações ativas pertencentes às categorias vinculadas ao usuário autenticado, que não foram criadas pelo próprio usuário e que ainda não possuem negociação iniciada pelo usuário.",
