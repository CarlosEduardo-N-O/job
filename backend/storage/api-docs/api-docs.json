                "responses": {
                    "200": {
                        "description": "Lista de publicações disponíveis"
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Publicações"
                ],
                "summary": "Cria uma nova publicação",
                "operationId": "cf7e4b6378851cf1d4688cc486ec9843",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "categoria_id",
                                    "titulo",
                                    "descricao"
                                ],
                                "properties": {
                                    "categoria_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "titulo": {
                                        "type": "string",
                                        "example": "Preciso de um eletricista"
                                    },
                                    "descricao": {
                                        "type": "string",
                                        "example": "Preciso instalar três tomadas em minha residência."
                                    },
                                    "valor_estimado": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 250
                                    },
                                    "cidade": {
                                        "type": "string",
                                        "example": "Rio do Sul"
                                    },
                                    "estado": {
                                        "type": "string",
                                        "example": "SC"
                                    },
                                    "endereco_servico": {
                                        "type": "string",
                                        "example": "Rua das Flores, 100"
                                    },
                                    "data_inicio": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-09-15"
                                    },
                                    "horario_inicio": {
                                        "type": "string",
                                        "example": "14:00"
                                    },
                                    "data_fim": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-09-20"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Publicação criada"
                    },
                    "422": {
                        "description": "Dados inválidos"
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
